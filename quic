#!/usr/bin/env bash
#
# optimize-xui.sh — системная оптимизация VPS под Hysteria 2 / QUIC в 3x-ui
#
# Что делает:
#   1. Увеличивает UDP-буферы ядра до 16 MB (нужно для высоких скоростей QUIC)
#   2. Включает BBR + fq на уровне ядра
#   3. Повышает приоритет x-ui.service (Nice=-5) — снижает джиттер
#
# Поддерживаемые ОС: Debian 11/12, Ubuntu 20.04/22.04/24.04, AlmaLinux/Rocky 8/9
# Требования: root, установленный 3x-ui
#
# Использование:
#   sudo bash optimize-xui.sh
#   sudo bash optimize-xui.sh --nice -10
#   sudo bash optimize-xui.sh --nice 0 --no-restart
#
set -euo pipefail

# ---------- Параметры по умолчанию ----------
NICE_VALUE="-5"
RESTART_XUI="yes"
SYSCTL_FILE="/etc/sysctl.d/99-xray-optimizations.conf"
DROPIN_DIR="/etc/systemd/system/x-ui.service.d"
DROPIN_FILE="${DROPIN_DIR}/20-local.conf"
UDP_BUF="16777216"

# ---------- Цвета ----------
if [[ -t 1 ]]; then
    R='\033[0;31m'; G='\033[0;32m'; Y='\033[0;33m'; B='\033[0;34m'; N='\033[0m'
else
    R=''; G=''; Y=''; B=''; N=''
fi

log()  { echo -e "${B}==>${N} $*"; }
ok()   { echo -e "${G}  ✔${N} $*"; }
warn() { echo -e "${Y}  ⚠${N} $*"; }
die()  { echo -e "${R}  ✘${N} $*" >&2; exit 1; }

# ---------- Разбор аргументов ----------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --nice)       NICE_VALUE="$2"; shift 2 ;;
        --no-restart) RESTART_XUI="no"; shift ;;
        -h|--help)
            sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *) die "Неизвестный аргумент: $1 (см. --help)" ;;
    esac
done

# ---------- Проверки ----------
[[ $EUID -eq 0 ]] || die "Запустите от root (sudo bash $0)"

command -v systemctl >/dev/null || die "systemd не найден — скрипт только для systemd-систем"
command -v sysctl    >/dev/null || die "sysctl не найден"

if ! systemctl list-unit-files | grep -q '^x-ui.service'; then
    die "x-ui.service не найден. Установлен ли 3x-ui? (systemctl status x-ui)"
fi

if ! [[ "$NICE_VALUE" =~ ^-?[0-9]+$ ]] || (( NICE_VALUE < -20 || NICE_VALUE > 19 )); then
    die "Некорректное значение --nice: $NICE_VALUE (допустимо -20..19)"
fi

log "Начинаю оптимизацию $(hostname) ($(uname -r))"
log "Nice для x-ui: $NICE_VALUE   Перезапуск x-ui: $RESTART_XUI"

# ---------- 1. Sysctl ----------
log "1/3 Настройка sysctl (UDP-буферы, BBR, fq)"
tee "$SYSCTL_FILE" >/dev/null <<EOF
# Xray/Hysteria2 optimization — generated by optimize-xui.sh
net.core.rmem_max = ${UDP_BUF}
net.core.wmem_max = ${UDP_BUF}
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
EOF
sysctl --system >/dev/null
ok "Sysctl применён: $SYSCTL_FILE"

# ---------- 2. Nice для x-ui ----------
log "2/3 Повышение приоритета x-ui.service (Nice=${NICE_VALUE})"
mkdir -p "$DROPIN_DIR"
cat > "$DROPIN_FILE" <<EOF
# Managed by optimize-xui.sh
[Service]
Nice=${NICE_VALUE}
EOF
systemctl daemon-reload
ok "Drop-in создан: $DROPIN_FILE"

if [[ "$RESTART_XUI" == "yes" ]]; then
    systemctl restart x-ui
    ok "x-ui перезапущен"
else
    warn "x-ui НЕ перезапущен (--no-restart). Nice применится при следующем рестарте."
fi

# ---------- 3. Проверка ----------
log "3/3 Проверка"

echo
echo "Процессы x-ui/xray (NI должен быть ${NICE_VALUE}):"
ps -eo pid,ni,comm | awk -v n="$NICE_VALUE" '
    /x-ui|xray/ {
        color = ($2 == n) ? "\033[0;32m" : "\033[0;31m"
        reset = "\033[0m"
        printf "  %6s  %3s  %s%s%s\n", $1, $2, color, $3, reset
    }
'

echo
echo "Sysctl (ожидаем ${UDP_BUF} / bbr):"
sysctl net.core.rmem_max net.core.wmem_max net.ipv4.tcp_congestion_control | sed 's/^/  /'

echo
ok "Готово. Не забудьте в веб-панели 3x-ui выставить окна QUIC:"
echo "     initConnectionReceiveWindow = 41943040"
echo "     maxConnectionReceiveWindow  = 41943040"
echo "     (init/maxStreamReceiveWindow оставить 16777216)"
